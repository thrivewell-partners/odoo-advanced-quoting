<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-inherit="sale.ListRenderer.RecordRow" t-inherit-mode="extension">
        <!-- A bundle always hides its members' prices; Unset Bundle shows them again. -->
        <xpath expr="//DropdownItem[contains(@onSelected, 'collapse_prices')]" position="attributes">
            <attribute name="t-if">props.hidePrices and !record.data.twp_is_bundle and !record.data.twp_standalone</attribute>
        </xpath>
        <!-- A standalone divider groups nothing, so it neither hides its lines nor takes a
             subsection. -->
        <xpath expr="//DropdownItem[contains(@onSelected, 'collapse_composition')]" position="attributes">
            <attribute name="t-if">props.hideComposition and !record.data.twp_standalone</attribute>
        </xpath>
        <xpath expr="//DropdownItem[contains(@onSelected, 'addRowInSection(record, true)')]" position="attributes">
            <attribute name="t-if">!record.data.twp_standalone</attribute>
        </xpath>
        <!-- Odoo's optional section prints 0.00 and reads like Set Add-on beside it, so it is
             offered only to undo it. -->
        <xpath expr="//DropdownItem[contains(@onSelected, 'toggleIsOptional')]" position="attributes">
            <attribute name="t-if">record.data.is_optional</attribute>
        </xpath>
        <t t-name="composition_button" position="after">
            <DropdownItem t-if="this.twpCanSetBundle(record)" onSelected="() => this.twpToggleBundle(record)">
                <i class="me-1 fa fa-fw fa-cube"/>
                <span t-if="record.data.twp_is_bundle">Unset Bundle</span>
                <span t-else="">Set Bundle</span>
            </DropdownItem>
            <DropdownItem t-if="record.data.twp_is_bundle" onSelected="() => this.twpAddAdjustment(record)">
                <i class="me-1 fa fa-fw fa-wrench"/><span>Add Adjustment</span>
            </DropdownItem>
            <DropdownItem t-if="this.twpCanAddStandalone(record)" onSelected="() => this.twpAddStandalone(record)">
                <i class="me-1 fa fa-fw fa-level-up"/><span>Add Standalone Lines</span>
            </DropdownItem>
            <t t-if="!this.twpOptionsLocked(record)">
                <DropdownItem
                    t-if="record.data.twp_option_mode !== 'included'"
                    onSelected="() => this.twpToggleChosen(record)"
                >
                    <i class="me-1 fa fa-fw" t-att-class="record.data.twp_option_chosen ? 'fa-square-o' : 'fa-check-square-o'"/>
                    <span t-if="record.data.twp_option_chosen">Mark Not Chosen</span>
                    <span t-else="">Mark Chosen</span>
                </DropdownItem>
                <DropdownItem
                    t-if="record.data.twp_option_mode !== 'alternative' and this.twpCanSetOption(record)"
                    onSelected="() => this.twpSetOptionMode(record, 'alternative')"
                >
                    <i class="me-1 fa fa-fw fa-random"/><span>Set Alternative</span>
                </DropdownItem>
                <DropdownItem
                    t-if="record.data.twp_option_mode !== 'addon' and this.twpCanSetOption(record)"
                    onSelected="() => this.twpSetOptionMode(record, 'addon')"
                >
                    <i class="me-1 fa fa-fw fa-plus-square-o"/><span>Set Add-on</span>
                </DropdownItem>
                <DropdownItem
                    t-if="record.data.twp_option_mode !== 'included'"
                    onSelected="() => this.twpSetOptionMode(record, 'included')"
                >
                    <i class="me-1 fa fa-fw fa-undo"/>
                    <span t-if="record.data.twp_option_mode === 'alternative'">Unset Alternative</span>
                    <span t-else="">Unset Add-on</span>
                </DropdownItem>
            </t>
        </t>
    </t>

    <t t-inherit="sale_management.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[contains(@onSelected, 'toggleIsOptional')]" position="attributes">
            <attribute name="t-if">record.data.is_optional</attribute>
        </xpath>
        <t t-name="composition_button" position="after">
            <DropdownItem onSelected="() => this.twpToggleBundle(record)">
                <i class="me-1 fa fa-fw fa-cube"/>
                <span t-if="record.data.twp_is_bundle">Unset Bundle</span>
                <span t-else="">Set Bundle</span>
            </DropdownItem>
        </t>
    </t>

</templates>
