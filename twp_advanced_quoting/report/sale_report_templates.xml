<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='layout_document_title']/span[2]" position="before">
            <span t-elif="doc.state in ['draft', 'sent'] and doc.twp_document_style_id.title_word">
                <t t-out="doc.twp_document_style_id.title_word"/> #
            </span>
        </xpath>

        <!-- Header fields, then the introduction, above the lines -->
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="doc.twp_quote_number and doc.twp_quote_number != doc.name" class="col" name="twp_quote_number">
                <strong>Quote Number</strong>
                <div t-field="doc.twp_quote_number">REDQ0001</div>
            </div>
        </xpath>
        <xpath expr="//div[@id='informations']" position="after">
            <t t-set="twp_header_fields" t-value="doc._twp_header_fields()"/>
            <div t-if="twp_header_fields" class="row mb-4" id="twp_informations">
                <div t-foreach="twp_header_fields" t-as="twp_field" class="col" t-att-name="twp_field['name']">
                    <strong t-out="twp_field['label']">Job Name</strong>
                    <div t-out="twp_field['value']">Main Street School</div>
                </div>
            </div>
            <div t-if="doc._twp_show_introduction()" class="mb-4" name="twp_introduction">
                <div t-field="doc.twp_introduction"/>
            </div>
        </xpath>

        <!-- The style's line numbers and code column -->
        <xpath expr="//t[@t-set='display_taxes']" position="after">
            <t t-set="twp_show_numbers" t-value="doc.twp_document_style_id.show_line_numbers"/>
            <t t-set="twp_show_code" t-value="doc.twp_document_style_id.show_code_column"/>
            <t t-set="twp_numbers" t-value="doc._twp_line_numbers(lines_to_report) if twp_show_numbers else {}"/>
            <t t-set="twp_extra_columns" t-value="(1 if twp_show_numbers else 0) + (1 if twp_show_code else 0)"/>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th t-if="twp_show_numbers" name="twp_th_line_number" class="text-end">
                <t t-if="colspan_count is not None">
                    <t t-set="colspan_count" t-value="colspan_count + 1"/>
                </t>
                #
            </th>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th t-if="twp_show_code" name="twp_th_code" class="text-start text-nowrap">
                <t t-if="colspan_count is not None">
                    <t t-set="colspan_count" t-value="colspan_count + 1"/>
                </t>
                <t t-out="doc.twp_document_style_id.code_column_label">Model No.</t>
            </th>
        </xpath>

        <!-- Odoo 19 has shipped this table two ways. Newer builds count the header cells into
             colspan_count, which the cells above join. Databases whose Sales app was installed
             or last upgraded before that still carry the older copy, which adds up a fixed
             3 columns; there the extra columns are added here. -->
        <xpath expr="//tr[@name='tr_section']/t[@t-set='section_name_colspan']" position="after">
            <t t-if="colspan_count is None">
                <t t-set="section_name_colspan" t-value="section_name_colspan + twp_extra_columns"/>
            </t>
        </xpath>
        <xpath expr="//tr[@name='tr_combo']/td[@name='td_combo_name']" position="attributes">
            <attribute name="t-att-colspan">colspan_count if colspan_count is not None else 3 + (1 if display_discount else 0) + (1 if display_taxes else 0) + twp_extra_columns</attribute>
        </xpath>

        <!-- Hide Price on one line: the row prints as if its section hid prices, and the
             section's own setting comes back on the next row. -->
        <xpath expr="//t[@t-if='is_section']/t[@t-set='collapse_prices']" position="after">
            <t t-set="twp_section_collapse_prices" t-value="collapse_prices"/>
            <t t-set="twp_group_collapse_prices" t-value="collapse_prices"/>
        </xpath>
        <xpath expr="//t[@t-elif='is_subsection']/t[@t-set='collapse_prices']" position="after">
            <t t-set="collapse_prices" t-value="twp_section_collapse_prices or line.collapse_prices"/>
            <t t-set="twp_group_collapse_prices" t-value="collapse_prices"/>
        </xpath>
        <xpath expr="//tr[@name='tr_combo']/td[@name='td_combo_name']" position="before">
            <t t-set="collapse_prices" t-value="twp_group_collapse_prices"/>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_name']" position="before">
            <t t-set="collapse_prices" t-value="twp_group_collapse_prices or line.twp_hide_price"/>
            <td t-if="twp_show_numbers" name="twp_td_line_number" class="text-end">
                <span t-out="twp_numbers.get(line.id, '')">1</span>
            </td>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_name']/span" position="attributes">
            <attribute name="t-if">not twp_show_code</attribute>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_name']/span" position="after">
            <span t-if="twp_show_code" t-out="line._twp_name_without_code()" t-options="{'widget': 'text'}">Bacon Burger</span>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_name']" position="after">
            <td t-if="twp_show_code" name="twp_td_code" class="text-nowrap">
                <span t-out="line._twp_code()">FURN_0001</span>
            </td>
        </xpath>
        <xpath expr="//tr[@name='tr_section_group']/td[@name='td_section_group_name']" position="before">
            <td t-if="twp_show_numbers" name="twp_td_line_number"/>
        </xpath>
        <xpath expr="//tr[@name='tr_section_group']/td[@name='td_section_group_name']" position="after">
            <td t-if="twp_show_code" name="twp_td_code"/>
        </xpath>

        <!-- A bundle prints as one row: its packages, the price of one, and its amount. Odoo's
             own section row follows it as the next branch, so every other section is untouched. -->
        <xpath expr="//tr[@name='tr_section']" position="before">
            <tr t-if="(is_section or is_subsection) and line.twp_is_bundle" name="twp_tr_bundle"
                t-att-class="'fw-bolder o_line_section' if is_section else 'fw-bold o_line_subsection'">
                <t t-set="twp_bundle_row" t-value="line._twp_bundle_row(price_field)"/>
                <td t-if="twp_show_numbers" name="twp_td_line_number"/>
                <td name="twp_td_bundle_name" t-att-class="padding_class">
                    <span t-field="line.name">Heater package</span>
                </td>
                <td t-if="twp_show_code" name="twp_td_code"/>
                <td name="twp_td_bundle_quantity" class="text-end">
                    <span class="text-nowrap twp_bundle_qty" t-out="twp_bundle_row['qty']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}">5.00</span>
                </td>
                <td name="twp_td_bundle_priceunit" class="text-end text-nowrap">
                    <span t-if="twp_bundle_row['show_prices'] and twp_bundle_row['package_price'] is not False" class="twp_package_price" t-out="twp_bundle_row['package_price']" t-options="{'widget': 'float', 'decimal_precision': 'Product Price'}">1,260.00</span>
                </td>
                <td t-if="display_discount" name="twp_td_bundle_discount"/>
                <td t-if="display_taxes" name="twp_td_bundle_taxes" class="text-end">
                    <span t-out="line._twp_section_tax_labels()">Tax 15%</span>
                </td>
                <td name="twp_td_bundle_subtotal" class="text-end o_price_total">
                    <span t-if="twp_bundle_row['show_prices']" class="text-nowrap twp_bundle_amount" t-out="twp_bundle_row['amount']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">6,300.00</span>
                </td>
            </tr>
        </xpath>
        <xpath expr="//tr[@name='tr_section']" position="attributes">
            <attribute name="t-if"/>
            <attribute name="t-elif">is_section or is_subsection</attribute>
        </xpath>

        <!-- A bundle that hides its composition prints its packages on its summary row. -->
        <xpath expr="//td[@name='td_section_group_quantity']/span" position="attributes">
            <attribute name="t-if">not line.twp_is_bundle</attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_group_quantity']/span" position="before">
            <span t-if="line.twp_is_bundle" class="twp_bundle_qty" t-out="line.twp_bundle_qty" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}">5.00</span>
        </xpath>
        <xpath expr="//td[@name='td_section_group_priceunit']/span" position="attributes">
            <attribute name="t-out">section_line['price_subtotal'] / line.twp_bundle_qty if line.twp_is_bundle and line.twp_bundle_qty else section_line['price_subtotal']</attribute>
        </xpath>

        <!-- A member prints its quantity per bundle, if the company prints them that way. -->
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_quantity']/span[@t-field='line.product_uom_qty']" position="attributes">
            <attribute name="t-if">not twp_per_bundle</attribute>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_quantity']/span[@t-field='line.product_uom_qty']" position="before">
            <t t-set="twp_per_bundle" t-value="line._twp_print_per_bundle()"/>
            <span t-if="twp_per_bundle" t-field="line.twp_qty_per_bundle" class="text-nowrap twp_qty_per_bundle">3</span>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_quantity']/span[@t-field='line.product_uom_id']" position="after">
            <span t-if="twp_per_bundle" class="text-muted small text-nowrap">per package</span>
        </xpath>

        <xpath expr="//div[@name='so_total_summary']" position="attributes">
            <attribute name="t-if">doc.twp_document_style_id.totals_mode != 'hidden'</attribute>
        </xpath>
    </template>

</odoo>
