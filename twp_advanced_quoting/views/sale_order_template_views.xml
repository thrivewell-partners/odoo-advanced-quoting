<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_template_view_form" model="ir.ui.view">
        <field name="name">sale.order.template.form.twp_advanced_quoting</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_template_line_ids']/list/field[@name='is_optional']" position="after">
                <field name="twp_is_bundle" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_line_ids']/list/field[@name='sequence']" position="after">
                <field name="twp_hide_on_documents" string="Print" widget="twp_print_toggle" optional="show"
                       invisible="display_type" width="40px"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_line_ids']/list" position="inside">
                <field name="twp_hide_price" optional="hide" invisible="display_type"/>
                <!-- Last, so the bundle's row can keep it. Quantities inside a bundle are per bundle. -->
                <field name="twp_bundle_qty" optional="show" invisible="not twp_is_bundle" readonly="not twp_is_bundle"/>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="twp_document_style_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//page[@name='terms_and_conditions']" position="before">
                <page string="Introduction" name="twp_introduction">
                    <field name="twp_introduction" nolabel="1" placeholder="Printed above the lines of a quote made from this template, in place of the default in Sales Settings."/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
