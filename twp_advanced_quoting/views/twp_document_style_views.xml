<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="twp_document_style_view_list" model="ir.ui.view">
        <field name="name">twp.document.style.list</field>
        <field name="model">twp.document.style</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="structure"/>
                <field name="title_word"/>
                <field name="totals_mode"/>
                <field name="show_line_numbers"/>
                <field name="show_code_column"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="twp_document_style_view_form" model="ir.ui.view">
        <field name="name">twp.document.style.form</field>
        <field name="model">twp.document.style</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Contractor"/></h1>
                    </div>
                    <group>
                        <group string="Who It Is For">
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="e.g. Distributor"/>
                            <field name="structure" widget="radio"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group string="Printing">
                            <field name="title_word" placeholder="Quotation"/>
                            <field name="order_title_word" placeholder="Order"/>
                            <field name="totals_mode"/>
                        </group>
                        <group string="Columns">
                            <field name="show_line_numbers"/>
                            <field name="show_code_column"/>
                            <field name="code_column_label" invisible="not show_code_column"/>
                            <field name="discount_column"/>
                            <field name="show_taxes"/>
                        </group>
                        <group string="Quote Fields That Print">
                            <field name="print_job_name"/>
                            <field name="print_ship_via"/>
                            <field name="print_fob"/>
                            <field name="print_freight"/>
                            <field name="print_lead_time"/>
                            <field name="print_introduction"/>
                        </group>
                    </group>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="twp_document_style_action" model="ir.actions.act_window">
        <field name="name">Document Styles</field>
        <field name="res_model">twp.document.style</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="twp_document_style_menu"
        action="twp_document_style_action"
        parent="sale.menu_sale_config"
        sequence="25"
        groups="sales_team.group_sale_manager"/>

</odoo>
