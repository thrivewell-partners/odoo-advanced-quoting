<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The customer's online quote follows the PDF: header fields, introduction, Hide Price,
         and the style's line numbers and code column. -->
    <template id="sale_order_portal_content" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//tbody[@id='sale_info_table']" position="inside">
            <tr t-if="sale_order.twp_quote_number and sale_order.twp_quote_number != sale_order.name" name="twp_quote_number">
                <th class="ps-0 pb-0">Quote Number:</th>
                <td class="w-100 pb-0 text-wrap"><span t-field="sale_order.twp_quote_number"/></td>
            </tr>
            <tr t-foreach="sale_order._twp_header_fields()" t-as="twp_field" t-att-name="twp_field['name']">
                <th class="ps-0 pb-0"><t t-out="twp_field['label']"/>:</th>
                <td class="w-100 pb-0 text-wrap"><span t-out="twp_field['value']"/></td>
            </tr>
        </xpath>
        <xpath expr="//section[@id='details']" position="before">
            <section t-if="sale_order._twp_show_estimate_note()" id="twp_estimate_note" class="mb-4">
                <div t-field="sale_order.company_id.twp_estimate_note"/>
            </section>
            <section t-if="sale_order._twp_show_introduction()" id="twp_introduction" class="mb-4">
                <div t-field="sale_order.twp_introduction"/>
            </section>
            <div t-if="sale_order._twp_needs_choice()" id="twp_needs_choice" class="alert alert-info d-print-none" role="status">
                This quote has options to choose between. Let us know which you would like, and we will
                send it back to you to accept.
            </div>
        </xpath>

        <xpath expr="//t[@t-set='display_taxes']" position="after">
            <t t-set="twp_net_prices" t-value="sale_order._twp_net_prices()"/>
            <t t-set="display_discount" t-value="display_discount and not twp_net_prices"/>
            <t t-set="display_taxes" t-value="display_taxes and sale_order._twp_show_taxes()"/>
            <t t-set="twp_show_numbers" t-value="sale_order.twp_document_style_id.show_line_numbers"/>
            <t t-set="twp_show_code" t-value="sale_order.twp_document_style_id.show_code_column"/>
            <t t-set="twp_numbers" t-value="sale_order._twp_line_numbers(lines_to_report) if twp_show_numbers else {}"/>
            <t t-set="twp_extra_columns" t-value="(1 if twp_show_numbers else 0) + (1 if twp_show_code else 0)"/>
        </xpath>
        <xpath expr="//th[@id='product_name_header']" position="before">
            <th t-if="twp_show_numbers" class="text-end" id="twp_line_number_header">#</th>
        </xpath>
        <xpath expr="//th[@id='product_name_header']" position="after">
            <th t-if="twp_show_code" class="text-start text-nowrap" id="twp_code_header">
                <t t-out="sale_order.twp_document_style_id.code_column_label"/>
            </th>
        </xpath>
        <!-- Net prices: the price with its discount taken off, without the struck-out list price. -->
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_priceunit']/t/div[1]" position="attributes">
            <attribute name="t-if" add="not (twp_net_prices and line.discount)" separator=" and "/>
        </xpath>
        <xpath expr="//tr[@name='tr_section']/t[@t-set='section_name_colspan']" position="attributes">
            <attribute name="t-value">3 + (1 if display_discount else 0) + (1 if display_taxes else 0) + twp_extra_columns</attribute>
        </xpath>

        <xpath expr="//t[@t-if='is_section']/t[@t-set='collapse_prices']" position="after">
            <t t-set="twp_group_collapse_prices" t-value="collapse_prices"/>
        </xpath>
        <xpath expr="//t[@t-elif='is_subsection']/t[@t-set='collapse_prices']" position="after">
            <t t-set="twp_group_collapse_prices" t-value="collapse_prices"/>
        </xpath>
        <xpath expr="//tr[@name='tr_combo']/td[@name='td_combo_name']" position="before">
            <t t-set="collapse_prices" t-value="twp_group_collapse_prices"/>
            <td t-if="twp_show_numbers" name="twp_td_line_number"/>
        </xpath>
        <xpath expr="//tr[@name='tr_combo']/td[@name='td_combo_name']" position="after">
            <td t-if="twp_show_code" name="twp_td_code"/>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_name']" position="before">
            <t t-set="collapse_prices" t-value="twp_group_collapse_prices or line.twp_hide_price"/>
            <t t-set="twp_per_bundle" t-value="line._twp_print_per_bundle()"/>
            <td t-if="twp_show_numbers" name="twp_td_line_number" class="text-end">
                <span t-out="twp_numbers.get(line.id, '')"/>
            </td>
        </xpath>
        <xpath expr="//span[@name='span_product_name']" position="attributes">
            <attribute name="t-if">not twp_show_code</attribute>
        </xpath>
        <xpath expr="//span[@name='span_product_name']" position="after">
            <span t-if="twp_show_code" t-out="line._twp_name_without_code()" t-options="{'widget': 'text'}"/>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_name']" position="after">
            <td t-if="twp_show_code" name="twp_td_code" class="text-nowrap">
                <span t-out="line._twp_code()"/>
            </td>
        </xpath>
        <xpath expr="//tr[@name='tr_section_group']/td[@name='td_section_group_name']" position="before">
            <td t-if="twp_show_numbers" name="twp_td_line_number" class="text-end">
                <span t-out="twp_numbers.get(line.id, '')"/>
            </td>
        </xpath>
        <xpath expr="//tr[@name='tr_section_group']/td[@name='td_section_group_name']" position="after">
            <td t-if="twp_show_code" name="twp_td_code"/>
        </xpath>

        <!-- Bundles, as on the PDF -->
        <xpath expr="//tr[@name='tr_section']" position="before">
            <tr t-if="(is_section or is_subsection) and line.twp_is_bundle" name="twp_tr_bundle"
                t-att-class="'fw-bolder o_line_section' if is_section else 'fw-bold o_line_subsection'">
                <t t-set="twp_bundle_row" t-value="line._twp_bundle_row(price_field)"/>
                <td t-if="twp_show_numbers" name="twp_td_line_number" class="text-end">
                    <span t-out="twp_numbers.get(line.id, '')"/>
                </td>
                <td name="twp_td_bundle_name" t-att-class="padding_class">
                    <span t-field="line.name"/>
                    <t t-call="twp_advanced_quoting.option_note"/>
                </td>
                <td t-if="twp_show_code" name="twp_td_code"/>
                <td name="twp_td_bundle_quantity" class="text-end">
                    <span class="text-nowrap twp_bundle_qty" t-out="twp_bundle_row['qty']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                </td>
                <td name="twp_td_bundle_priceunit" t-attf-class="text-end text-nowrap {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}">
                    <span t-if="twp_bundle_row['show_prices'] and twp_bundle_row['package_price'] is not False" class="twp_package_price" t-out="twp_bundle_row['package_price']" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id}"/>
                </td>
                <td t-if="display_discount" name="twp_td_bundle_discount" t-attf-class="{{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}"/>
                <td t-if="display_taxes" name="twp_td_bundle_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span t-out="line._twp_section_tax_labels('name')"/>
                </td>
                <td name="twp_td_bundle_subtotal" class="text-end o_price_total">
                    <span t-if="twp_bundle_row['show_prices']" class="text-nowrap twp_bundle_amount" t-out="twp_bundle_row['amount']" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id}"/>
                </td>
            </tr>
        </xpath>
        <xpath expr="//tr[@name='tr_section']" position="attributes">
            <attribute name="t-if"/>
            <attribute name="t-elif">is_section or is_subsection</attribute>
        </xpath>
        <xpath expr="//tr[@name='tr_section']/td[@name='td_section_name_xs']/span" position="after">
            <t t-call="twp_advanced_quoting.option_note"/>
        </xpath>
        <xpath expr="//tr[@name='tr_section']/td[@name='td_section_name_sm']/span" position="after">
            <t t-call="twp_advanced_quoting.option_note"/>
        </xpath>
        <xpath expr="//tr[@name='tr_section']/td[@name='td_section_name']/span" position="after">
            <t t-call="twp_advanced_quoting.option_note"/>
        </xpath>
        <xpath expr="//td[@name='td_section_group_name']/span" position="after">
            <t t-call="twp_advanced_quoting.option_note"/>
        </xpath>

        <!-- Totals, as on the PDF -->
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="t-if">sale_order._twp_show_totals()</attribute>
        </xpath>
        <xpath expr="//div[@id='total']/div/t[@t-call='sale.sale_order_portal_content_totals_table']" position="after">
            <t t-call="twp_advanced_quoting.option_totals">
                <t t-set="order" t-value="sale_order"/>
            </t>
        </xpath>
        <xpath expr="//td[@name='td_section_group_quantity']/span" position="attributes">
            <attribute name="t-if">not line.twp_is_bundle</attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_group_quantity']/span" position="before">
            <span t-if="line.twp_is_bundle" class="twp_bundle_qty" t-out="line.twp_bundle_qty" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
        </xpath>
        <xpath expr="//td[@name='td_section_group_priceunit']/span" position="attributes">
            <attribute name="t-out">section_line['price_subtotal'] / line.twp_bundle_qty if line.twp_is_bundle and line.twp_bundle_qty else section_line['price_subtotal']</attribute>
        </xpath>
        <xpath expr="//span[@name='span_product_name']" position="before">
            <t t-set="twp_per_bundle_label" t-value="line._twp_per_bundle_label() if twp_per_bundle else ''"/>
            <t t-if="twp_per_bundle_label">
                <span class="text-nowrap twp_qty_per_bundle" t-out="twp_per_bundle_label"/>
                <t t-out="' '"/>
            </t>
        </xpath>
        <!-- Sales Management replaces Odoo's quantity block with its own, so the cell's first
             child is whichever of the two is installed. -->
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_quantity']/*[1]" position="attributes">
            <attribute name="t-if">not twp_per_bundle</attribute>
        </xpath>
    </template>

    <!-- The sidebar's total follows the page's, and net prices show no saving. -->
    <template id="sale_order_portal_template" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@name='sale_order_advantage']" position="attributes">
            <attribute name="t-if" add="not sale_order._twp_net_prices()" separator=" and "/>
        </xpath>
        <xpath expr="//h2[@t-field='sale_order.amount_total']" position="before">
            <t t-elif="not sale_order._twp_show_totals()"/>
        </xpath>
    </template>

</odoo>
