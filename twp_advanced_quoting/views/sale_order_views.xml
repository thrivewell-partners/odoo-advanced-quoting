<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.twp_advanced_quoting</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- The Confirm buttons ask what the customer chose, when the quote has options. -->
            <xpath expr="//header/button[@name='action_confirm'][1]" position="attributes">
                <attribute name="context">{'validate_analytic': True, 'twp_ask_options': True}</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][2]" position="attributes">
                <attribute name="context">{'validate_analytic': True, 'twp_ask_options': True}</attribute>
            </xpath>
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="twp_job_name"/>
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='payment_term_id']" position="after">
                <field name="twp_quote_number" invisible="not twp_quote_number or twp_quote_number == name"/>
                <field name="twp_document_style_id" options="{'no_create': True}"/>
                <field name="twp_ship_via"/>
                <field name="twp_fob"/>
                <field name="twp_freight"/>
                <field name="twp_lead_time"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Introduction" name="twp_introduction">
                    <field name="twp_introduction" nolabel="1" placeholder="Printed above the lines. The default is set in Sales Settings."/>
                </page>
                <page string="Margins" name="twp_section_margins" invisible="not twp_section_margins">
                    <field name="twp_section_margins" nolabel="1"/>
                </page>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='collapse_prices']" position="after">
                <field name="twp_is_bundle" column_invisible="1"/>
                <field name="twp_in_bundle" column_invisible="1"/>
                <field name="twp_option_mode" column_invisible="1"/>
                <field name="twp_option_group" column_invisible="1"/>
                <field name="twp_option_chosen" column_invisible="1"/>
                <field name="twp_not_chosen" column_invisible="1"/>
            </xpath>
            <!-- Inside a bundle only the quantity per bundle is typed (D15). -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="twp_qty_per_bundle" optional="show" invisible="display_type or not twp_in_bundle"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly" add="twp_in_bundle" separator=" or "/>
            </xpath>
            <!-- Just left of the amount, so a bundle's or an option's row can keep them beside the
                 section total. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal'][1]" position="before">
                <field name="twp_option_group" string="Option Group" optional="hide"
                       invisible="twp_option_mode != 'alternative' or not display_type"
                       readonly="twp_option_mode != 'alternative' or not display_type"
                       placeholder="One set"/>
                <field name="twp_option_label" widget="badge" optional="show" width="140px"
                       invisible="not twp_option_label"
                       decoration-success="twp_option_chosen" decoration-muted="twp_not_chosen"/>
                <field name="twp_bundle_qty" string="Bundle Qty" optional="show"
                       invisible="not twp_is_bundle" readonly="not twp_is_bundle"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//div[@name='ordered_qty']/field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly">twp_in_bundle</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//div[@name='ordered_qty']" position="after">
                <field name="twp_in_bundle" invisible="1"/>
                <field name="twp_qty_per_bundle" invisible="not twp_in_bundle"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="twp_hide_price" optional="hide" invisible="display_type"/>
                <field name="twp_hide_on_documents" optional="hide" invisible="display_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">sale.order.list.twp_advanced_quoting</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="twp_job_name" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter" model="ir.ui.view">
        <field name="name">sale.order.search.twp_advanced_quoting</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="twp_job_name"/>
                <field name="twp_quote_number"/>
            </field>
        </field>
    </record>

</odoo>
