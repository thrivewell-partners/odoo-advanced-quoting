<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.twp_bids</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_sale_quotations_new']" position="after">
                <button string="New Bid" name="action_twp_new_bid" type="object"
                        invisible="type == 'lead' or probability == 0 and not active"/>
            </xpath>
            <xpath expr="//button[@name='action_view_sale_quotation']" position="before">
                <button class="oe_stat_button" type="object" name="action_twp_view_bids" icon="fa-gavel"
                        invisible="type == 'lead' or not twp_bid_count">
                    <field name="twp_bid_count" widget="statinfo" string="Bids"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
